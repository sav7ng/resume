# Caddy config for serving the static export.
#
# Install to /etc/caddy/Caddyfile on the server, then:
#   caddy validate --config /etc/caddy/Caddyfile
#   systemctl reload caddy
#
# Replace resume.example.com with your domain. Caddy provisions HTTPS
# automatically as long as the domain's A/AAAA record points at this host and
# ports 80/443 are reachable.

resume.example.com {
	root * /var/www/resume
	encode zstd gzip
	file_server

	# Hashed build assets never change under the same name.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML must revalidate so a redeploy is picked up immediately.
	@html {
		path *.html /
		path */
	}
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# Everything else (images, pdf, og image): a day, revalidated after.
	@assets {
		path *.png *.jpg *.svg *.pdf *.webmanifest
	}
	header @assets Cache-Control "public, max-age=86400"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}
}
